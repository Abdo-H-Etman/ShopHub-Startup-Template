@using myshop.BLL.DTOs.Product
@model IEnumerable<ProductListDto>
@{
    ViewData["Title"] = "ShopHub";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .hero-section {
        margin-top: 30px;
        padding: 80px 20px;
        border-radius: 24px;
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        color: white;
        box-shadow: 0 15px 35px rgba(30, 58, 138, .25);
    }

    .hero-section h1 {
        font-size: 48px;
        font-weight: 800;
        margin-bottom: 15px;
    }

    .hero-section p {
        font-size: 20px;
        margin-bottom: 30px;
    }

    .product-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0, 0, 0, .08);
        transition: .25s ease;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, .14);
    }

    .product-image-container {
        height: 220px;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 20px;
    }

    .category-badge {
        width: fit-content;
        padding: 5px 10px;
        border-radius: 20px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 12px;
        font-weight: 600;
    }

    .product-price {
        font-size: 19px;
        font-weight: 700;
        color: #1e3a8a;
    }
</style>

<div class="container">

    <!-- Hero -->
    <section class="hero-section text-center">

        <h1>Welcome to ShopHub</h1>

        <p>
            Discover quality products at great prices.
        </p>

        <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-store me-2"></i>
            Browse All Products
        </a>

    </section>


    <!-- Products -->
    <section class="py-5">

        <div class="d-flex justify-content-between
            align-items-center mb-4">

            <div>
                <h2 class="fw-bold mb-1">
                    Featured Products
                </h2>

                <p class="text-muted mb-0">
                    Check out some of our latest products.
                </p>
            </div>

            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                View All
            </a>

        </div>


        <div class="row g-4">

            @foreach (var product in Model.Take(4))
            {
                <div class="col-12 col-sm-6 col-lg-3">

                    <div class="card product-card h-100">

                        <div class="product-image-container">

                            <img src="@Url.Content(
                                                                         string.IsNullOrWhiteSpace(product.Img)
                                                                             ? "~/Images/no-image.png"
                                                                             : "~/" + product.Img)" class="product-image" alt="@product.Name"
                                 onerror="this.src='/Images/no-image.png';" />

                        </div>

                        <div class="card-body d-flex flex-column">

                            <span class="category-badge">
                                @product.CategoryName
                            </span>

                            <h5 class="fw-bold mt-2">
                                @product.Name
                            </h5>

                            <p class="text-muted flex-grow-1">
                                @product.Description
                            </p>

                            <div class="d-flex justify-content-between
                                align-items-center mt-3">

                                <span class="product-price">
                                    $@product.Price.ToString("N2")
                                </span>

                                <form asp-controller="Cart" asp-action="Add" method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="productId" value="@product.Id" />

                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa-solid fa-cart-plus"></i>
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </section>

</div>
