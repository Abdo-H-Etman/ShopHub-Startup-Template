@using myshop.BLL.DTOs.Product
@model IEnumerable<ProductListDto>
@{
    ViewData["Title"] = "ShopHub";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .hero-section {
        margin-top: 30px;
        padding: 80px 20px;
        border-radius: 24px;
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        color: white;
        box-shadow: 0 15px 35px rgba(30, 58, 138, .25);
    }

    .hero-section h1 {
        font-size: 48px;
        font-weight: 800;
        margin-bottom: 15px;
    }

    .hero-section p {
        font-size: 20px;
        margin-bottom: 30px;
    }

    .product-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0, 0, 0, .08);
        transition: .25s ease;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, .14);
    }

    .product-image-container {
        height: 220px;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 20px;
    }

    .category-badge {
        width: fit-content;
        padding: 5px 10px;
        border-radius: 20px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 12px;
        font-weight: 600;
    }

    .product-price {
        font-size: 19px;
        font-weight: 700;
        color: #1e3a8a;
    }
</style>

<div class="container">

    <!-- Hero -->
    <section class="hero-section text-center">

        <h1>Welcome to ShopHub</h1>

        <p>
            Discover quality products at great prices.
        </p>

        <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-store me-2"></i>
            Browse All Products
        </a>

    </section>


    <!-- Products -->
    <section class="py-5">

        <div class="d-flex justify-content-between
            align-items-center mb-4">

            <div>
                <h2 class="fw-bold mb-1">
                    Featured Products
                </h2>

                <p class="text-muted mb-0">
                    Check out some of our latest products.
                </p>
            </div>

            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                View All
            </a>

        </div>


        <div class="row g-4">

            @foreach (var product in Model.OrderByDescending(p => p.AverageRating).Take(4))
            {
                <div class="col-12 col-sm-6 col-lg-3">

                    <div class="card product-card h-100 position-relative">

                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                           class="text-decoration-none">
                            <div class="product-image-container">
                                <img src="@Url.Content(string.IsNullOrWhiteSpace(product.Img) ? "~/Images/no-image.png" : "~/" + product.Img)"
                                     class="product-image" alt="@product.Name" onerror="this.src='/Images/no-image.png';" />
                            </div>
                        </a>

                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="category-badge">
                                    @product.CategoryName
                                </span>

                                <div class="d-flex align-items-center gap-1" style="font-size: 13px; color: #f59e0b;">
                                    <i class="fa-solid fa-star"></i>
                                    <span class="fw-bold text-dark">@(product.AverageRating > 0 ?
                                                                                                                                                            product.AverageRating.ToString("N1") : "New")</span>
                                        @if (product.ReviewCount > 0)
                                        {
                                            <span class="text-muted" style="font-size: 11px;">(@product.ReviewCount)</span>
                                        }
                                    </div>
                                </div>

                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                                   class="text-decoration-none text-dark">
                                    <h5 class="fw-bold mt-1 text-truncate" title="@product.Name">
                                        @product.Name
                                    </h5>
                                </a>

                                <p class="text-muted flex-grow-1 small"
                                   style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @product.Description
                                </p>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">

                                    <span class="product-price">
                                        $@product.Price.ToString("N2")
                                    </span>

                                    <form asp-controller="Cart" asp-action="Add" method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="productId" value="@product.Id" />

                                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                            <i class="fa-solid fa-cart-plus me-1"></i> Add
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </section>

    </div>
