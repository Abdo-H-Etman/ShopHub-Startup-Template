@using myshop.Entities.ViewModels
@model PaginationVM

@if (Model.TotalPages > 1)
{
    <nav aria-label="Pagination">

        <ul class="pagination justify-content-center mt-5">

            <!-- Previous -->
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">

                @{
                    var previousRouteValues = new Dictionary<string, string?>(Model.RouteValues)
                    {
                        ["pageNumber"] = (Model.PageNumber - 1).ToString()
                    };
                }

                <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                   asp-all-route-data="previousRouteValues">
                    Previous
                </a>

            </li>


            <!-- Page Numbers -->
            @for (var pageNum = 1; pageNum <= Model.TotalPages; pageNum++)
            {
                var pageRouteValues = new Dictionary<string, string?>(Model.RouteValues)
                {
                    ["pageNumber"] = pageNum.ToString()
                };

                <li class="page-item @(pageNum == Model.PageNumber ? "active" : "")">

                    <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                       asp-all-route-data="pageRouteValues">

                        @pageNum

                    </a>

                </li>
            }


            <!-- Next -->
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">

                @{
                    var nextRouteValues = new Dictionary<string, string?>(Model.RouteValues)
                    {
                        ["pageNumber"] = (Model.PageNumber + 1).ToString()
                    };
                }

                <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                   asp-all-route-data="nextRouteValues">
                    Next
                </a>

            </li>

        </ul>

    </nav>
}