@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using myshop.Entities.ViewModels
@model ProductIndexVM

@if (!Model.Products.Any())
{
    <div class="text-center py-5">
        <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
        <h4>No products available</h4>
        <p class="text-muted">
            Check back later for new products.
        </p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var product in Model.Products)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card product-card h-100 position-relative">
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none">
                        <div class="product-image-container">
                            <img src="@Url.Content(string.IsNullOrWhiteSpace(product.Img) ? "~/Images/no-image.png" : "~/" + product.Img)"
                                 class="product-image" alt="@product.Name" onerror="this.src='/Images/no-image.png';" />
                        </div>
                    </a>
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="category-badge">
                                @product.CategoryName
                            </span>

                            <div class="d-flex align-items-center gap-1" style="font-size: 13px; color: #f59e0b;">
                                <i class="fa-solid fa-star"></i>
                                <span class="fw-bold text-dark">@(product.AverageRating > 0 ?
                                                                                                                                                                                                                                                                                                                            product.AverageRating.ToString("N1") : "New")</span>
                                    @if (product.ReviewCount > 0)
                                    {
                                        <span class="text-muted" style="font-size: 11px;">(@product.ReviewCount)</span>
                                    }
                                </div>
                            </div>

                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                               class="text-decoration-none text-dark">
                                <h5 class="card-title fw-bold text-truncate" title="@product.Name">
                                    @product.Name
                                </h5>
                            </a>

                            <p class="card-text text-muted flex-grow-1 small"
                               style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @product.Description
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="product-price">
                                    $@product.Price.ToString("N2")
                                </span>
                                <form asp-controller="Cart" asp-action="Add" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Add
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @{
        var pagination = new myshop.Entities.ViewModels.PaginationVM
        {
            PageNumber = Model.PageNumber,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,

            Controller = "Product",
            Action = "Index",

            RouteValues = new Dictionary<string, string?>
            {
                ["pageSize"] = Model.PageSize.ToString(),
                ["search"] = Model.Search ?? string.Empty,
                ["sort"] = Model.Sort ?? string.Empty
            }
        };
    }

    <partial name="_pagination" model="pagination" />
    }