@using myshop.Entities.ViewModels

@model ProductIndexVM

@{
    ViewData["Title"] = "Products";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .product-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 8px 25px rgba(0, 0, 0, .08);
        transition: .25s ease;
    }

    .product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, .14);
    }

    .product-image-container {
        height: 250px;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 20px;
        transition: transform .3s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .category-badge {
        display: inline-block;
        width: fit-content;
        padding: 5px 10px;
        border-radius: 20px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 12px;
        font-weight: 600;
    }

    .product-price {
        font-size: 20px;
        font-weight: 700;
        color: #1e3a8a;
    }

    .product-card .btn-primary {
        border-radius: 9px;
        font-weight: 600;
    }
</style>
<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Our Products</h1>
        <p class="text-muted">
            Discover our latest products and find something you love.
        </p>
    </div>

    <form id="productFilterForm" asp-controller="Product" asp-action="Index" method="get" class="row g-3 mb-5">

        <div class="col-md-6">
            <div class="input-group">
                <input type="text" id="searchInput" name="search" value="@Context.Request.Query["search"]" class="form-control"
                       placeholder="Search products (type at least 3 characters)..." autocomplete="off" />

                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-search"></i>
                    Search
                </button>
            </div>
        </div>

        <div class="col-md-3">
            <select id="sortSelect" name="sort" class="form-select">

                <option value="nameasc" selected="@(Context.Request.Query["sort"] == "nameasc")">
                    Name: A-Z
                </option>

                <option value="namedesc" selected="@(Context.Request.Query["sort"] == "namedesc")">
                    Name: Z-A
                </option>

                <option value="priceasc" selected="@(Context.Request.Query["sort"] == "priceasc")">
                    Price: Low to High
                </option>

                <option value="pricedesc" selected="@(Context.Request.Query["sort"] == "pricedesc")">
                    Price: High to Low
                </option>

            </select>
        </div>

        <div class="col-md-3">
            <select id="pageSizeSelect" name="pageSize" class="form-select">

                <option value="8" selected="@(Model.PageSize == 8)">
                    8 per page
                </option>

                <option value="12" selected="@(Model.PageSize == 12)">
                    12 per page
                </option>

                <option value="24" selected="@(Model.PageSize == 24)">
                    24 per page
                </option>

            </select>
        </div>

        <input type="hidden" id="pageNumber" name="pageNumber" />

    </form>

    <div id="productListContainer" style="transition: opacity 0.2s ease;">
        @await Html.PartialAsync("_ProductListPartial", Model)
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let debounceTimer = null;
            const searchInput = document.getElementById("searchInput");
            const sortSelect = document.getElementById("sortSelect");
            const pageSizeSelect = document.getElementById("pageSizeSelect");
            const pageNumberInput = document.getElementById("pageNumber");
            const productListContainer = document.getElementById("productListContainer");
            const filterForm = document.getElementById("productFilterForm");

            let lastSearchTerm = searchInput.value.trim();

            function fetchProducts(pageNumber = 1) {
                const search = searchInput.value.trim();
                const sort = sortSelect.value;
                const pageSize = pageSizeSelect.value;
                pageNumberInput.value = pageNumber;

                const params = new URLSearchParams({
                    search: search,
                    sort: sort,
                    pageSize: pageSize,
                    pageNumber: pageNumber,
                    ajax: "true"
                });

                const newUrl = `${window.location.pathname}?search=${encodeURIComponent(search)}&sort=${encodeURIComponent(sort)}&pageSize=${encodeURIComponent(pageSize)}&pageNumber=${pageNumber}`;
                window.history.replaceState({}, '', newUrl);

                productListContainer.style.opacity = "0.4";

                fetch(`/Product/Index?${params.toString()}`, {
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                })
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, "text/html");
                    const parsedContainer = doc.getElementById("productListContainer");

                    if (parsedContainer) {
                        productListContainer.innerHTML = parsedContainer.innerHTML;
                    } else {
                        productListContainer.innerHTML = html;
                    }
                    productListContainer.style.opacity = "1";
                })
                .catch(err => {
                    console.error("Failed to load products:", err);
                    productListContainer.style.opacity = "1";
                });
            }

            // Live search: triggers when >= 3 characters or cleared back to 0
            searchInput.addEventListener("input", function () {
                const term = this.value.trim();
                clearTimeout(debounceTimer);

                if (term.length >= 3 || (term.length === 0 && lastSearchTerm.length > 0)) {
                    debounceTimer = setTimeout(function () {
                        lastSearchTerm = term;
                        fetchProducts(1);
                    }, 300);
                }
            });

            // Prevent full page reload on Form Submit (e.g. Enter key or Search button)
            filterForm.addEventListener("submit", function (e) {
                e.preventDefault();
                clearTimeout(debounceTimer);
                lastSearchTerm = searchInput.value.trim();
                fetchProducts(1);
            });

            // Sort change preserves current page
            sortSelect.addEventListener("change", function () {
                fetchProducts(1);
            });

            // Page size change resets to page 1
            pageSizeSelect.addEventListener("change", function () {
                fetchProducts(1);
            });

            // AJAX pagination clicks
            productListContainer.addEventListener("click", function (e) {
                const link = e.target.closest("a.page-link");
                if (link && !link.closest("li.page-item.disabled")) {
                    e.preventDefault();
                    const url = new URL(link.href, window.location.origin);
                    const page = url.searchParams.get("pageNumber") || 1;
                    fetchProducts(page);
                }
            });
        });
    </script>
}