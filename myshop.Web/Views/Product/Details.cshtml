@model myshop.Web.ViewModels.ProductDetailsVM

@{
    ViewData["Title"] = Model.Product.Name;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .product-details-container {
        padding: 40px 0;
    }

    .product-main-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        border: 1px solid #eef2f6;
        padding: 35px;
        margin-bottom: 40px;
    }

    .product-image-box {
        background: #f8fafc;
        border-radius: 16px;
        padding: 30px;
        height: 380px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
    }

    .product-image-box img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .product-image-box:hover img {
        transform: scale(1.05);
    }

    .rating-stars {
        color: #f59e0b;
        font-size: 16px;
    }

    .rating-stars-lg {
        color: #f59e0b;
        font-size: 22px;
    }

    .reviews-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        border: 1px solid #eef2f6;
        padding: 35px;
    }

    .rating-summary-box {
        background: #f8fafc;
        border-radius: 16px;
        padding: 25px;
        text-align: center;
        border: 1px solid #e2e8f0;
    }

    .star-bar-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
        font-size: 13px;
    }

    .star-bar-container {
        flex-grow: 1;
        height: 8px;
        background: #e2e8f0;
        border-radius: 4px;
        overflow: hidden;
    }

    .star-bar-fill {
        height: 100%;
        background: #f59e0b;
        border-radius: 4px;
    }

    .review-item {
        padding: 20px 0;
        border-bottom: 1px solid #f1f5f9;
    }

    .review-item:last-child {
        border-bottom: none;
    }

    .star-rating-input {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 8px;
    }

    .star-rating-input input {
        display: none;
    }

    .star-rating-input label {
        font-size: 28px;
        color: #cbd5e1;
        cursor: pointer;
        transition: color 0.15s ease;
    }

    .star-rating-input label:hover,
    .star-rating-input label:hover ~ label,
    .star-rating-input input:checked ~ label {
        color: #f59e0b;
    }

    .category-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 13px;
        font-weight: 600;
    }
</style>

<div class="container product-details-container">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" class="text-decoration-none">Products</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Product.Name</li>
        </ol>
    </nav>

    <!-- Main Product Card -->
    <div class="product-main-card">
        <div class="row g-4 align-items-center">

            <!-- Product Image -->
            <div class="col-lg-5">
                <div class="product-image-box">
                    <img src="@Url.Content(string.IsNullOrWhiteSpace(Model.Product.Img) ? "~/Images/no-image.png" : "~/" + Model.Product.Img)"
                         alt="@Model.Product.Name" onerror="this.src='/Images/no-image.png';" />
                </div>
            </div>

            <!-- Product Info -->
            <div class="col-lg-7">
                <div class="ps-lg-3">
                    <span class="category-badge mb-2">@Model.Product.CategoryName</span>
                    <h1 class="fw-bold text-dark mb-2">@Model.Product.Name</h1>

                    <!-- Rating Stars Header -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="rating-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(Model.RatingSummary.AverageRating))
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star text-muted"></i>
                                }
                            }
                        </div>
                        <span class="fw-bold">@Model.RatingSummary.AverageRating.ToString("N1")</span>
                        <span class="text-muted">(@Model.RatingSummary.ReviewCount @(Model.RatingSummary.ReviewCount == 1 ? "review" : "reviews"))</span>
                    </div>

                    <h2 class="text-primary fw-bold mb-3">$@Model.Product.Price.ToString("N2")</h2>

                    <p class="text-muted mb-4 fs-5" style="line-height: 1.7;">
                        @Model.Product.Description
                    </p>

                    <!-- Add to Cart Form -->
                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-3 align-items-center flex-wrap">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Product.Id" />

                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                            <i class="fa-solid fa-cart-plus me-2"></i> Add to Cart
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <!-- Product Reviews & Ratings Section -->
    <div class="reviews-card" id="reviews-section">
        <h3 class="fw-bold mb-4">Customer Reviews & Ratings</h3>

        <div class="row g-4 mb-5">
            <!-- Left: Rating Summary Card -->
            <div class="col-lg-4">
                <div class="rating-summary-box">
                    <h1 class="display-3 fw-bold text-primary mb-0">@Model.RatingSummary.AverageRating.ToString("N1")</h1>
                    <div class="rating-stars-lg my-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(Model.RatingSummary.AverageRating))
                            {
                                <i class="fa-solid fa-star"></i>
                            }
                            else
                            {
                                <i class="fa-regular fa-star text-muted"></i>
                            }
                        }
                    </div>
                    <p class="text-muted mb-3">Based on @Model.RatingSummary.ReviewCount customer @(Model.RatingSummary.ReviewCount == 1 ? "review" : "reviews")</p>

                    <!-- Star Breakdown -->
                    @for (int star = 5; star >= 1; star--)
                    {
                        var count = Model.RatingSummary.RatingCounts.ContainsKey(star) ? Model.RatingSummary.RatingCounts[star] : 0;
                        var percentage = Model.RatingSummary.ReviewCount > 0 ? (count * 100) / Model.RatingSummary.ReviewCount : 0;
                        <div class="star-bar-row">
                            <span style="width: 50px;">@star Stars</span>
                            <div class="star-bar-container">
                                <div class="star-bar-fill" style="width: @percentage%;"></div>
                            </div>
                            <span style="width: 30px; text-align: right;" class="text-muted">@count</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Write / Edit Review Card -->
            <div class="col-lg-8">
                @if (Model.UserReview != null)
                {
                    <!-- User already reviewed: Show their review with Edit/Delete options -->
                    <div class="card border-primary p-4 rounded-4 bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="fw-bold text-primary mb-0"><i class="fa-solid fa-user-check me-2"></i>Your Review</h5>
                            <span class="text-muted small">@Model.UserReview.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                        </div>

                        <div class="rating-stars mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Model.UserReview.Rating)
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star text-muted"></i>
                                }
                            }
                        </div>

                        <p class="text-dark mb-3">@Model.UserReview.Comment</p>

                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="collapse" data-bs-target="#editReviewCollapse">
                                <i class="fa-solid fa-pen me-1"></i> Edit Review
                            </button>

                            <form asp-controller="Review" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete your review?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.UserReview.Id" />
                                <input type="hidden" name="productId" value="@Model.Product.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="fa-solid fa-trash me-1"></i> Delete
                                </button>
                            </form>
                        </div>

                        <!-- Edit Form Collapse -->
                        <div class="collapse mt-3" id="editReviewCollapse">
                            <div class="card card-body bg-white border-0 shadow-sm rounded-3">
                                <form asp-controller="Review" asp-action="Edit" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@Model.UserReview.Id" />
                                    <input type="hidden" name="ProductId" value="@Model.Product.Id" />

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Your Rating</label>
                                        <div class="star-rating-input">
                                            @for (int s = 5; s >= 1; s--)
                                            {
                                                <input type="radio" id="edit-star-@s" name="Rating" value="@s" checked="@(Model.UserReview.Rating == s)" required />
                                                <label for="edit-star-@s" title="@s stars"><i class="fa-solid fa-star"></i></label>
                                            }
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Your Review</label>
                                        <textarea name="Comment" class="form-control" rows="3" required>@Model.UserReview.Comment</textarea>
                                    </div>

                                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                                        Update Review
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else if (Model.IsAuthenticated)
                {
                    <!-- User hasn't reviewed: Show Review Form -->
                    <div class="card p-4 rounded-4 border-0 shadow-sm bg-light">
                        <h5 class="fw-bold mb-3"><i class="fa-solid fa-pen-nib me-2 text-primary"></i>Write a Review</h5>
                        <form asp-controller="Review" asp-action="Add" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ProductId" value="@Model.Product.Id" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Rating</label>
                                <div class="star-rating-input">
                                    <input type="radio" id="star-5" name="Rating" value="5" required />
                                    <label for="star-5" title="5 stars"><i class="fa-solid fa-star"></i></label>
                                    <input type="radio" id="star-4" name="Rating" value="4" />
                                    <label for="star-4" title="4 stars"><i class="fa-solid fa-star"></i></label>
                                    <input type="radio" id="star-3" name="Rating" value="3" />
                                    <label for="star-3" title="3 stars"><i class="fa-solid fa-star"></i></label>
                                    <input type="radio" id="star-2" name="Rating" value="2" />
                                    <label for="star-2" title="2 stars"><i class="fa-solid fa-star"></i></label>
                                    <input type="radio" id="star-1" name="Rating" value="1" />
                                    <label for="star-1" title="1 star"><i class="fa-solid fa-star"></i></label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Your Review</label>
                                <textarea name="Comment" class="form-control" rows="3" placeholder="What did you like or dislike about this product?" required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                                <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="card p-4 rounded-4 border-0 shadow-sm bg-light text-center">
                        <i class="fa-solid fa-lock fa-2x text-muted mb-2"></i>
                        <h5 class="fw-bold">Have you purchased or used this product?</h5>
                        <p class="text-muted mb-3">Please sign in to share your thoughts and help other shoppers.</p>
                        <div>
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary rounded-pill px-4">
                                Sign In to Write a Review
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- All Customer Reviews List -->
        <h5 class="fw-bold mb-3">All Reviews (@Model.Reviews.Count)</h5>

        @if (!Model.Reviews.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="fa-regular fa-comment-dots fa-2x mb-2"></i>
                <p>No reviews yet. Be the first to review this product!</p>
            </div>
        }
        else
        {
            <div class="reviews-list">
                @foreach (var review in Model.Reviews)
                {
                    <div class="review-item">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 14px;">
                                    @(string.IsNullOrEmpty(review.UserFullName) ? "U" : review.UserFullName[0].ToString().ToUpper())
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold text-dark">@review.UserFullName</h6>
                                    <small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("MMMM dd, yyyy")</small>
                                </div>
                            </div>

                            <div class="rating-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= review.Rating)
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star text-muted"></i>
                                    }
                                }
                            </div>
                        </div>

                        <p class="text-muted mt-2 mb-0" style="padding-left: 44px;">
                            @review.Comment
                        </p>
                    </div>
                }
            </div>
        }

    </div>

</div>
