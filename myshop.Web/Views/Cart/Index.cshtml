@model List<myshop.BLL.DTOs.Cart.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    var hasItems = Model != null && Model.Any();
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Shopping Cart</h2>

        <form asp-action="Clear" method="post" id="clearCartForm" class="@(hasItems ? "" : "d-none")">
            @Html.AntiForgeryToken()

            <button type="button" class="btn btn-outline-danger" id="btnClearCart">
                Clear Cart
            </button>
        </form>
    </div>

    <div id="emptyCartMessage" class="text-center py-5 @(hasItems ? "d-none" : "")">
        <h4>Your cart is empty.</h4>

        <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">
            Continue Shopping
        </a>
    </div>

    <div id="cartContentWrapper" class="@(hasItems ? "" : "d-none")">
        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Unit Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody id="cartTableBody">

                    @if (hasItems)
                    {
                        foreach (var item in Model!)
                        {
                            <tr id="cart-row-@item.ProductId" data-product-id="@item.ProductId">

                                <td>
                                    <div class="d-flex align-items-center">

                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="~/@item.ImageUrl" alt="@item.ProductName" style="width:70px; height:70px; object-fit:cover;" class="rounded me-3" />
                                        }

                                        <span>@item.ProductName</span>

                                    </div>
                                </td>

                                <td>
                                    @item.Price.ToString("C")
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">

                                        <form asp-action="Decrease" method="post" class="form-decrease">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="productId" value="@item.ProductId" />

                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-decrease" data-product-id="@item.ProductId">
                                                -
                                            </button>

                                        </form>

                                        <span id="quantity-@item.ProductId" class="fw-semibold px-1">
                                            @item.Quantity
                                        </span>

                                        <form asp-action="Increase" method="post" class="form-increase">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="productId" value="@item.ProductId" />

                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-increase" data-product-id="@item.ProductId">
                                                +
                                            </button>

                                        </form>

                                    </div>
                                </td>

                                <td>
                                    <span id="total-@item.ProductId" class="fw-semibold">
                                        @item.TotalPrice.ToString("C")
                                    </span>
                                </td>

                                <td>

                                    <form asp-action="Remove" method="post" class="remove-cart-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="productId" value="@item.ProductId" />

                                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-item" data-product-name="@item.ProductName" data-product-id="@item.ProductId">
                                            Remove
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

        <div class="d-flex justify-content-end mt-4">

            <div class="text-end">

                <h4>
                    Order Total:
                    <strong id="cartOrderTotal">
                        @(hasItems ? Model!.Sum(x => x.Price * x.Quantity).ToString("C") : "$0.00")
                    </strong>
                </h4>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/cart.js"></script>
}
