@using myshop.BLL.DTOs.Common
@using myshop.BLL.DTOs.Order
@using myshop.Entities.ViewModels

@model PagedResultDto<OrderSummaryDto>

@if (Model.Items == null || !Model.Items.Any())
{
    <div class="orders-card text-center py-5">
        <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>

        <h4 class="fw-bold">No orders found</h4>

        <p class="text-muted mb-4">
            You haven't placed any orders yet.
            Explore our products and place your first order!
        </p>

        <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
            Start Shopping
        </a>
    </div>
}
else
{
    <div class="orders-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total Amount</th>
                        <th>Order Status</th>
                        <th>Payment</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model.Items)
                    {
                        <tr>
                            <td class="fw-bold text-primary">
                                #@order.Id
                            </td>

                            <td class="text-muted">
                                @order.OrderDate.ToLocalTime().ToString("dd MMM yyyy::hh:mm tt")
                            </td>

                            <td>
                                <span class="badge bg-light text-dark border">
                                    @order.ItemCount item(s)
                                </span>
                            </td>

                            <td class="fw-bold">
                                $@order.TotalPrice.ToString("N2")
                            </td>

                            <td>
                                @{
                                    var statusClass = order.OrderStatus switch
                                    {
                                        "Shipped" => "status-badge-shipped",
                                        "Approved" => "status-badge-approved",
                                        _ => "status-badge-pending"
                                    };
                                }

                                <span class="@statusClass">
                                    <i class="fa-solid fa-circle me-1" style="font-size: 8px;"></i>
                                    @order.OrderStatus
                                </span>
                            </td>

                            <td>
                                <span class="status-badge-approved">
                                    <i class="fa-solid fa-check me-1"></i>
                                    @(order.PaymentStatus ?? "Paid")
                                </span>
                            </td>

                            <td class="text-end">
                                <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                    <i class="fa-solid fa-eye me-1"></i>
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    var pagination = new PaginationVM
    {
        PageNumber = Model.PageNumber,
        PageSize = Model.PageSize,
        TotalPages = Model.TotalPages,

        Controller = "Order",
        Action = "Index",

        RouteValues = new Dictionary<string, string?>
        {
            ["pageSize"] = Model.PageSize.ToString(),
            ["sort"] = Context.Request.Query["sort"].ToString()
        }
    };

    <partial name="_pagination" model="pagination" />
}