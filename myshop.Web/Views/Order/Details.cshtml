@model myshop.BLL.DTOs.Order.OrderHeaderDto

@{
    ViewData["Title"] = $"Order #{Model.Id} Details";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .order-details-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        border: 1px solid #eef2f6;
        padding: 35px;
        margin-bottom: 25px;
    }

    .status-badge-approved {
        background: #ecfdf5;
        color: #059669;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        display: inline-block;
    }

    .table thead th {
        background: #f8fafc;
        color: #475569;
        font-weight: 600;
        font-size: 13px;
        text-transform: uppercase;
        border-bottom: 2px solid #e2e8f0;
        padding: 12px 16px;
    }

    .table tbody td {
        padding: 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }
</style>

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <a asp-action="Index" class="btn btn-link text-decoration-none text-muted p-0 mb-2">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to My Orders
            </a>
            <h2 class="fw-bold mb-0">Order #@Model.Id</h2>
        </div>

        <div class="d-flex gap-2 align-items-center">
            <span class="status-badge-approved">
                <i class="fa-solid fa-circle-check me-1"></i> Status: @Model.OrderStatus
            </span>
            <span class="status-badge-approved">
                <i class="fa-solid fa-credit-card me-1"></i> Payment: @(Model.PaymentStatus ?? "Approved")
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Order info & Customer Info -->
        <div class="col-lg-4">
            <div class="order-details-card h-100">
                <h5 class="fw-bold mb-3 pb-2 border-bottom">
                    <i class="fa-solid fa-location-dot text-primary me-2"></i> Delivery Details
                </h5>

                <div class="mb-3">
                    <label class="text-muted small">Recipient</label>
                    <p class="fw-semibold mb-0">@Model.Name</p>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Address</label>
                    <p class="fw-semibold mb-0">@Model.Address, @Model.City @Model.PostalCode</p>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Contact Phone</label>
                    <p class="fw-semibold mb-0">@Model.PhoneNumber</p>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Order Placed On</label>
                    <p class="fw-semibold mb-0">@Model.OrderDate.ToLocalTime().ToString("MMMM dd, yyyy - hh:mm tt")</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                {
                    <div class="mb-0">
                        <label class="text-muted small">Tracking Number</label>
                        <p class="fw-semibold text-primary mb-0">@Model.TrackingNumber (@Model.Carrier)</p>
                    </div>
                }
            </div>
        </div>

        <!-- Items Table -->
        <div class="col-lg-8">
            <div class="order-details-card h-100 p-0 overflow-hidden">
                <div class="p-4 pb-0">
                    <h5 class="fw-bold mb-3">
                        <i class="fa-solid fa-bag-shopping text-primary me-2"></i> Order Items (@Model.OrderDetails.Sum(d => d.Count))
                    </h5>
                </div>

                <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-center">Unit Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@Url.Content(string.IsNullOrWhiteSpace(item.ProductImg) ? "~/Images/no-image.png" : "~/" + item.ProductImg)"
                                                 alt="@item.ProductName" style="width: 50px; height: 50px; object-fit: cover;" class="rounded border"
                                                 onerror="this.src='/Images/no-image.png';" />
                                            <div>
                                                <h6 class="mb-0 fw-semibold text-dark">@item.ProductName</h6>
                                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="small text-primary text-decoration-none">
                                                    View Product
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center text-muted">$@item.Price.ToString("N2")</td>
                                    <td class="text-center fw-semibold">@item.Count</td>
                                    <td class="text-end fw-bold text-dark">$@item.TotalPrice.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold py-3 fs-5">Grand Total:</td>
                                <td class="text-end fw-bold py-3 fs-5 text-primary">$@Model.TotalPrice.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
