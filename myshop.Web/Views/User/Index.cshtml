@{
    ViewBag.PageTitle = "Users Management";
    ViewBag.CardTitle = "View Users";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<style>
    .custom-card {
        background: rgba(255, 255, 255, .75);
        backdrop-filter: blur(12px);
        border-radius: 18px;
        border: 1px solid rgba(160, 173, 186, .35);
        box-shadow: 0 15px 35px rgba(0, 0, 0, .12);
        padding: 28px;
        animation: fadeIn .4s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .custom-card-title {
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        padding: 18px;
        border-radius: 14px;
        margin-bottom: 22px;
        text-align: center;
        color: white;
        font-weight: 700;
        letter-spacing: .6px;
        font-size: 22px;
        box-shadow: 0 4px 20px rgba(30, 58, 138, .35);
    }


    @*
    .change-role {
        width: 145px;
        text-align: center;
        white-space: nowrap;
    }

    .lock-user,
    .unlock-user {
        width: 90px;
        text-align: center;
        white-space: nowrap;
    }

    .delete-user {
        width: 38px;
        text-align: center;
        padding-left: 0;
        padding-right: 0;
    } *@

    .action-container {
        display: grid;
        grid-template-columns: 145px 90px 38px; /* Fixed column widths for slot 1, 2, and 3 */
        gap: 6px;
        justify-content: start; /* Aligns the grid to the right end of the cell */
    }

    .action-btn {
        margin: 0;
        text-align: center;
        white-space: nowrap;
    }
    #mytable thead th:last-child {
        text-align: right !important;
    }

    #mytable thead th {
        background: #1e40af !important;
        color: white !important;
        padding: 14px !important;
        border: none !important;
    }

    #mytable tbody td {
        background: white !important;
        padding: 14px !important;
        color: #1e3a8a;
        border-bottom: 1px solid #e3e8ef !important;
        vertical-align: middle;
    }

    #mytable tbody tr:hover td {
        background: #ebf2ff !important;
    }

    .action-btn {
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        border: none;
        margin: 2px;
    }

    .btn-admin {
        background: #2563eb;
        color: white;
    }

    .btn-admin:hover {
        background: #1d4ed8;
        color: white;
    }

    .btn-customer {
        background: #f59e0b;
        color: white;
    }

    .btn-customer:hover {
        background: #d97706;
        color: white;
    }

    .btn-lock {
        background: #dc2626;
        color: white;
    }

    .btn-lock:hover {
        background: #b91c1c;
        color: white;
    }

    .btn-unlock {
        background: #16a34a;
        color: white;
    }

    .btn-unlock:hover {
        background: #15803d;
        color: white;
    }

    .btn-delete {
        background: #7f1d1d;
        color: white;
    }

    .btn-delete:hover {
        background: #991b1b;
        color: white;
    }

    .role-badge,
    .lock-badge {
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
    }

    .role-admin {
        background: #dbeafe;
        color: #1e40af;
    }

    .role-customer {
        background: #fef3c7;
        color: #92400e;
    }

    .lock-active {
        background: #dcfce7;
        color: #166534;
    }

    .lock-locked {
        background: #fee2e2;
        color: #991b1b;
    }
</style>

<div class="custom-card">

    <div class="custom-card-title">
        <i class="fa-solid fa-users me-2"></i>
        Users List
    </div>

    <table id="mytable" class="display table-hover" width="100%">

        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Lock Status</th>
                <th class="actions-column">Actions</th>
            </tr>
        </thead>

    </table>

</div>

@section Scripts {

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script src="~/js/users.js"></script>
}