@using myshop.BLL.DTOs.Order
@model IEnumerable<OrderSummaryDto>

@{
    ViewBag.PageTitle = "Orders Management";
    ViewBag.CardTitle = "All Orders";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .custom-card {
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(12px);
        border-radius: 18px;
        border: 1px solid rgba(160,173,186,.35);
        box-shadow: 0 15px 35px rgba(0,0,0,.08);
        padding: 28px;
        animation: fadeIn .4s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .custom-card-title {
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        padding: 18px;
        border-radius: 14px;
        margin-bottom: 22px;
        text-align: center;
        color: white;
        font-weight: 700;
        letter-spacing: .6px;
        font-size: 22px;
        box-shadow: 0 4px 20px rgba(30,58,138,.35);
    }

    #ordersTable thead th {
        background: #1e40af !important;
        color: white !important;
        padding: 14px !important;
        border: none !important;
    }

    #ordersTable tbody td {
        background: white !important;
        padding: 13px !important;
        color: #1e3a8a;
        border-bottom: 1px solid #e3e8ef !important;
        vertical-align: middle;
    }

    #ordersTable tbody tr:hover td {
        background: #ebf2ff !important;
    }

    .badge-pending  { background: #fffbeb; color: #d97706; font-weight: 600; padding: 5px 12px; border-radius: 20px; font-size: 12px; }
    .badge-approved { background: #ecfdf5; color: #059669; font-weight: 600; padding: 5px 12px; border-radius: 20px; font-size: 12px; }
    .badge-shipped  { background: #eff6ff; color: #2563eb; font-weight: 600; padding: 5px 12px; border-radius: 20px; font-size: 12px; }
    .badge-cancelled{ background: #fef2f2; color: #dc2626; font-weight: 600; padding: 5px 12px; border-radius: 20px; font-size: 12px; }
</style>

<div class="custom-card">
    <div class="custom-card-title">
        <i class="fa-solid fa-truck me-2"></i> Orders Management
    </div>

    <div class="table-responsive">
        <table id="ordersTable" class="display table-hover" width="100%">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Order Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Order Status</th>
                    <th>Payment</th>
                    <th style="width:100px;">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#ordersTable').DataTable({
                ajax: {
                    url: '/Admin/Order/GetAllOrdersData',
                    type: 'GET',
                    dataSrc: 'data'
                },
                order: [[1, 'desc']],
                columns: [
                    {
                        data: 'id',
                        render: function (data) {
                            return '<strong class="text-primary">#' + data + '</strong>';
                        }
                    },
                    {
                        data: 'orderDate',
                        render: function (data) {
                            return new Date(data).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                        }
                    },
                    {
                        data: 'itemCount',
                        render: function (data) {
                            return '<span class="badge badge-secondary">' + data + ' item(s)</span>';
                        }
                    },
                    {
                        data: 'totalPrice',
                        render: function (data) {
                            return '<strong>$' + Number(data).toFixed(2) + '</strong>';
                        }
                    },
                    {
                        data: 'orderStatus',
                        render: function (data) {
                            const status = (data || 'Pending').toLowerCase();
                            const cls = status === 'approved' ? 'badge-approved'
                                      : status === 'shipped'  ? 'badge-shipped'
                                      : status === 'cancelled'? 'badge-cancelled'
                                      : 'badge-pending';
                            return '<span class="' + cls + '">' + (data || 'Pending') + '</span>';
                        }
                    },
                    {
                        data: 'paymentStatus',
                        render: function (data) {
                            return '<span class="badge-approved">' + (data || 'Approved') + '</span>';
                        }
                    },
                    {
                        data: 'id',
                        render: function (data) {
                            return `<a href="/Admin/Order/Details/${data}" class="btn btn-info btn-sm" title="View Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>`;
                        }
                    }
                ],
                autoWidth: false,
                scrollX: true
            });
        });
    </script>
}
